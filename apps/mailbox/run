#!/usr/bin/env bash
# Opens the mailbox on a running server's registry; it shows every project,
# reached first through the local socket of the one --project names:
#   apps/mailbox/run --config <server.toml> [--project <id>]
set -euo pipefail

usage() {
  printf 'usage: apps/mailbox/run --config <server.toml> [--project <id>]\n' >&2
  exit 1
}

config=""
project=()
while [[ $# -gt 0 ]]; do
  case $1 in
    --config) [[ $# -ge 2 ]] || usage; config=$2; shift 2 ;;
    --project) [[ $# -ge 2 ]] || usage; project=("$2"); shift 2 ;;
    *) usage ;;
  esac
done
[[ -n $config ]] || usage
[[ -f $config ]] || { printf 'mailbox: no server registry at %s\n' "$config" >&2; exit 1; }
config=$(realpath "$config")
app=$(dirname "$(realpath "$0")")
root=$(realpath "$app/../..")

XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$UID}
if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
  for candidate in "$XDG_RUNTIME_DIR"/wayland-*; do
    [[ -S $candidate ]] && WAYLAND_DISPLAY=${candidate##*/} && break
  done
fi
[[ -n ${WAYLAND_DISPLAY:-} ]] || { printf 'mailbox: no Wayland session found\n' >&2; exit 1; }

# The last line: a compile before the task prints its own lines first.
IFS=$'\t' read -r _ socket < <(cd "$root" && mise exec -- mix omunculus.socket "$config" "${project[@]}" | tail -n 1)
[[ -n ${socket:-} ]] || exit 1
[[ -S $socket ]] || { printf 'mailbox: no socket at %s; start `omunculus serve` first\n' "$socket" >&2; exit 1; }

export XDG_RUNTIME_DIR WAYLAND_DISPLAY QT_QPA_PLATFORM=wayland
export OMUNCULUS_MAILBOX_SOCKET=$socket
exec quickshell --path "$app"
