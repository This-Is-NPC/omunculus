#!/bin/sh
root="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
cwd="$PWD"

absolute() {
  case "$1" in
    /*) printf '%s' "$1" ;;
    *) printf '%s/%s' "$cwd" "$1" ;;
  esac
}

# mix runs in the package root, so a relative --config resolves here first.
case "$1" in
  serve)
    if [ "$2" = --config ] && [ -n "$3" ]; then
      config="$(absolute "$3")"
      shift 3
      set -- serve --config "$config" "$@"
    fi
    ;;
  socket) ;;
  --config)
    if [ -n "$2" ]; then
      config="$(absolute "$2")"
      shift 2
      set -- --config "$config" "$@"
    fi
    ;;
  *)
    set -- --config "$cwd/omunculus.toml" "$@"
    ;;
esac

# Installed, the release sits in lib/omunculus beside this launcher; in a
# checkout there is none and mix runs the same entry.
release="$root/lib/omunculus/bin/omunculus"
if [ -x "$release" ]; then
  # One node name per user would refuse a second command beside the server.
  export RELEASE_DISTRIBUTION=none
  exec "$release" eval 'Omunculus.Main.run(System.argv())' "$@"
fi

cd "$root" || exit 1
exec mise exec -- mix omunculus "$@"
