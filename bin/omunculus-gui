#!/usr/bin/env bash
# Opens the omunculus window on a project of a running server's registry:
#   bin/omunculus-gui --config <server.toml> [--project <id>]
set -euo pipefail

usage() {
  printf 'usage: omunculus-gui --config <server.toml> [--project <id>]\n' >&2
  exit 1
}

config=""
project=()
while [[ $# -gt 0 ]]; do
  case $1 in
    --config) [[ $# -ge 2 ]] || usage; config=$2; shift 2 ;;
    --project) [[ $# -ge 2 ]] || usage; project=("$2"); shift 2 ;;
    *) usage ;;
  esac
done
[[ -n $config ]] || usage
[[ -f $config ]] || { printf 'omunculus-gui: no server registry at %s\n' "$config" >&2; exit 1; }
config=$(realpath "$config")
root=$(realpath "$(dirname "$(realpath "$0")")/..")

XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$UID}
if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
  for candidate in "$XDG_RUNTIME_DIR"/wayland-*; do
    [[ -S $candidate ]] && WAYLAND_DISPLAY=${candidate##*/} && break
  done
fi
[[ -n ${WAYLAND_DISPLAY:-} ]] || { printf 'omunculus-gui: no Wayland session found\n' >&2; exit 1; }

# The last line: a compile before the task prints its own lines first.
IFS=$'\t' read -r id socket < <(cd "$root" && mise exec -- mix omunculus.socket "$config" "${project[@]}" | tail -n 1)
[[ -n ${socket:-} ]] || exit 1
[[ -S $socket ]] || { printf 'omunculus-gui: no socket at %s; start `omunculus serve` first\n' "$socket" >&2; exit 1; }

export XDG_RUNTIME_DIR WAYLAND_DISPLAY QT_QPA_PLATFORM=wayland
export OMUNCULUS_GUI_SOCKET=$socket OMUNCULUS_GUI_PROJECT=$id
exec quickshell --path "$root/gui"
