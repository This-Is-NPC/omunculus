#!/usr/bin/env python3
"""The bench's ticket system, an MCP server over stdio: tickets live here
and nowhere in a workspace, so an answer about them takes its tools."""
import json
import sys

TICKETS = {
    "T-482": {"title": "Checkout times out under load", "status": "open", "owner": "Ana Ruiz",
              "workaround": "raise the payment gateway timeout to 45 seconds"},
    "T-479": {"title": "Checkout button misaligned on mobile", "status": "closed", "owner": "Leo Park",
              "workaround": "none needed"},
    "T-490": {"title": "Search returns stale results", "status": "open", "owner": "Mei Chen",
              "workaround": "clear the search cache nightly"},
    "T-501": {"title": "Checkout fails for saved cards", "status": "open", "owner": "Ana Ruiz",
              "workaround": "ask the customer to enter the card again"},
}

TOOLS = [
    {"name": "search_tickets", "description": "Finds tickets whose title holds the words given, with their id, title and status.",
     "inputSchema": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}},
    {"name": "get_ticket", "description": "One ticket by its id: title, status, owner and workaround.",
     "inputSchema": {"type": "object", "properties": {"id": {"type": "string"}}, "required": ["id"]}},
]


def call(name, args):
    if name == "search_tickets":
        words = str(args.get("query", "")).lower().split()
        found = [{"id": id, "title": t["title"], "status": t["status"]}
                 for id, t in TICKETS.items() if all(w in t["title"].lower() for w in words)]
        return {"content": [{"type": "text", "text": json.dumps(found)}]}
    if name == "get_ticket":
        ticket = TICKETS.get(str(args.get("id", "")))
        if ticket is None:
            return {"content": [{"type": "text", "text": "no such ticket"}], "isError": True}
        return {"content": [{"type": "text", "text": json.dumps({"id": args["id"], **ticket})}]}
    return {"content": [{"type": "text", "text": "unknown tool"}], "isError": True}


for line in sys.stdin:
    if not line.strip():
        continue
    message = json.loads(line)
    method, id = message.get("method"), message.get("id")
    if method == "initialize":
        result = {"protocolVersion": message["params"]["protocolVersion"], "capabilities": {"tools": {}},
                  "serverInfo": {"name": "tickets", "version": "1"}}
    elif method == "tools/list":
        result = {"tools": TOOLS}
    elif method == "tools/call":
        result = call(message["params"]["name"], message["params"].get("arguments") or {})
    else:
        continue
    print(json.dumps({"jsonrpc": "2.0", "id": id, "result": result}), flush=True)
