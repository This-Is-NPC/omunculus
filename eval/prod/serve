#!/usr/bin/env python3
"""The bench's hosting: a site published by POSTing a .tar.gz of it to
/deploy is served from / on 127.0.0.1. It writes the port it listens on to
<dir>/port and logs each deploy to <dir>/deploys.log; it serves nothing
before the first deploy. Usage: serve <dir>"""
import http.server, io, pathlib, shutil, sys, tarfile, time

root = pathlib.Path(sys.argv[1]).resolve()
site = root / "site"


class Hosting(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(site), **kwargs)

    def do_POST(self):
        if self.path.rstrip("/") != "/deploy":
            return self.send_error(404, "POST a .tar.gz of the site to /deploy")
        body = self.rfile.read(int(self.headers.get("Content-Length", 0)))
        staged = root / "staged"
        shutil.rmtree(staged, ignore_errors=True)
        try:
            with tarfile.open(fileobj=io.BytesIO(body), mode="r:*") as archive:
                archive.extractall(staged, filter="data")
        except (tarfile.TarError, OSError) as error:
            return self.send_error(400, f"not a .tar.gz of the site: {error}")
        shutil.rmtree(site, ignore_errors=True)
        staged.rename(site)
        with open(root / "deploys.log", "a") as log:
            log.write(f"{time.time()}\n")
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b"published\n")

    def do_GET(self):
        if not site.is_dir():
            return self.send_error(404, "nothing published yet")
        super().do_GET()

    def log_message(self, *args):
        pass


server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Hosting)
(root / "port").write_text(str(server.server_address[1]))
server.serve_forever()
