#!/usr/bin/env python3
import pathlib, sys
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[2] / "_lib"))
from check import *

workspace, outcome = load()
expect_outcome(outcome, "done", "answer")
log = text(workspace, "CHANGELOG.md")
entries = re.findall(r"^## \[(\d+\.\d+\.\d+)\] - (\d{4}-\d{2}-\d{2})", log, re.M)
if not entries or entries[0] != ("1.4.0", "2026-10-08"):
    fail(f"the first entry is {entries[:1]}, not 1.4.0 dated 2026-10-08")
if len(entries) != 3:
    fail("an earlier entry was lost or doubled")
first = log.split("## [1.3.0]")[0]
for change in ["dark mode", "crash on empty notes"]:
    if change not in first.lower():
        fail(f"the entry lacks: {change}")
ok()
