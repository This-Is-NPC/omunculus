#!/usr/bin/env python3
import pathlib, sys
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[2] / "_lib"))
from check import *

import json, socket, subprocess, time, urllib.request
# The API runs from the environment set up in the workspace, on the real
# FastAPI, and does what was asked.
workspace, outcome = load()
expect_outcome(outcome, "done", "answer")
python = workspace / ".venv" / "bin" / "python"
if not python.exists():
    fail("no Python environment in the workspace (.venv)")
for fake in ["fastapi.py", "fastapi"]:
    if (workspace / fake).exists():
        fail(f"the workspace holds a {fake} of its own")
found = subprocess.run([str(python), "-c", "import fastapi; print(fastapi.__file__)"], capture_output=True, text=True)
if found.returncode != 0 or "site-packages" not in found.stdout:
    fail("FastAPI is not installed in .venv")
text(workspace, "app.py")

with socket.socket() as probe:
    probe.bind(("127.0.0.1", 0))
    port = probe.getsockname()[1]
# On a copy, so the check changes nothing and holds whatever items the
# agent added while it tried its own API.
import shutil, tempfile
copy = pathlib.Path(tempfile.mkdtemp())
shutil.copytree(workspace, copy, dirs_exist_ok=True, ignore=shutil.ignore_patterns(".venv"))
items = json.loads((copy / "items.json").read_text())
server = subprocess.Popen([str(python), "-m", "uvicorn", "app:app", "--port", str(port)], cwd=copy, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def call(method, path, body=None):
    request = urllib.request.Request(f"http://127.0.0.1:{port}{path}", method=method, data=json.dumps(body).encode() if body is not None else None, headers={"content-type": "application/json"})
    with urllib.request.urlopen(request, timeout=5) as response:
        return json.loads(response.read())

try:
    for _ in range(60):
        try:
            health = call("GET", "/health")
            break
        except OSError:
            time.sleep(0.25)
    else:
        fail("the API does not start with uvicorn app:app")
    if health != {"status": "ok"}:
        fail(f"GET /health returns {health}")
    if call("GET", "/items") != items:
        fail("GET /items does not return items.json")
    added = call("POST", "/items", {"name": "Washer", "price": 0.05})
    if added != {"id": max(item["id"] for item in items) + 1, "name": "Washer", "price": 0.05}:
        fail(f"POST /items returns {added}")
    if len(call("GET", "/items")) != len(items) + 1:
        fail("POST /items does not add the item")
finally:
    server.terminate()
    server.wait(timeout=10)
    shutil.rmtree(copy)
ok()
