#!/bin/sh
# The environment an agent sets up with mise, built once and shared by
# every selftest: a .venv in the workspace pointing at it.
set -e
cache="$(dirname "$0")/../../../../.cache/fastapi-venv"
if [ ! -x "$cache/bin/python" ]; then
  python3 -m venv "$cache"
  "$cache/bin/pip" install -q fastapi uvicorn httpx
fi
ln -s "$(cd "$cache" && pwd)" "$1/.venv"
