#!/usr/bin/env python3
import pathlib, sys
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[2] / "_lib"))
from check import *

# The house format, which only the release-notes skill gives.
workspace, outcome = load()
expect_outcome(outcome, "done", "answer")
notes = text(workspace, "RELEASE_NOTES.md")
if not re.search(r"^## v2\.0\.0 — 2026-10-08\s*$", notes, re.M):
    fail("no '## v2.0.0 — 2026-10-08' heading")
sections = re.findall(r"^### (.+?)\s*$", notes, re.M)
if sections != ["Breaking", "Added", "Fixed"]:
    fail(f"the sections are {sections}, not Breaking, Added, Fixed")
wanted = {"Breaking": ["212"], "Added": ["230"], "Fixed": ["241", "238"]}
for title, issues in wanted.items():
    block = re.search(rf"^### {title}\s*$(.*?)(?=^### |\Z)", notes, re.M | re.S).group(1)
    for line in bullets(block):
        if not re.search(r"\(#\d+\)$", line) or not re.match(r"[A-Z][a-z]+ed\b", line):
            fail(f"{line!r} is not '- <Verb>ed ... (#<issue>)'")
    found = sorted(re.findall(r"\(#(\d+)\)", block))
    if found != sorted(issues):
        fail(f"### {title} lists {found}, not {sorted(issues)}")
ok()
