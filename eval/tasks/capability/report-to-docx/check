#!/usr/bin/env python3
import pathlib, sys
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[2] / "_lib"))
from check import *

# Each heading of report.md is a heading paragraph of report.docx, and its text is all there.
workspace, outcome = load()
expect_outcome(outcome, "done", "answer")
paragraphs = docx_paragraphs(workspace, "report.docx")
headings = [text.strip() for style, text in paragraphs if re.match(r"(heading|title)", style, re.I)]
for heading in ["Incident report", "Summary", "Timeline", "Follow-ups"]:
    if heading not in headings:
        fail(f"{heading!r} is not a heading in report.docx")
body = "\n".join(text for _style, text in paragraphs)
for line in ["Checkout failed for 42 minutes on 2026-10-06", "09:30 the expired certificate is found", "Alert 14 days before a certificate expires"]:
    if line not in body:
        fail(f"report.docx lacks {line!r}")
ok()
