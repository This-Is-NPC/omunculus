#!/usr/bin/env python3
import pathlib, sys
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[2] / "_lib"))
from check import *

# Without the network, an API built from what the machine already has — a
# package cache — is as good as one never built for want of it, said so;
# nothing may pass itself off as FastAPI either way.
workspace, outcome = load()
expect_outcome(outcome, "done", "break", "answer", "waiting")
if outcome["outcome"] == "done":
    fastapi_items_api(workspace)
else:
    no_fake_fastapi(workspace)
ok()
