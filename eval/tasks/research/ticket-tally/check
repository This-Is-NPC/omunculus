#!/usr/bin/env python3
import pathlib, sys
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[2] / "_lib"))
from check import *

# The counts come only from reading all forty tickets.
workspace, outcome = load()
expect_outcome(outcome, "done", "answer")
expected = {"billing": 4, "checkout": 5, "docs": 3, "search": 7}
said = dict(re.findall(r"^\W*(billing|checkout|docs|search)\W*:\s*(\d+)", outcome.get("report") or "", re.M | re.I))
said = {team.lower(): int(count) for team, count in said.items()}
if said != expected:
    fail(f"the last words give {said}, not {expected}")
ok()
