#!/usr/bin/env bash
#MISE description="Run the server on the dev registry, with ANTHROPIC_API_KEY from .env, the deploy sockets and keys and your git identity"
#MISE depends=["dev:bootstrap"]
set -euo pipefail
cd "${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"

if [[ -f .env ]]; then
  set -a
  source .env
  set +a
fi
# The dream team's deploy sockets, while its environment is up: the folder
# the link names, as a command sees no link outside the folders it is given.
sockets=packs/dream-team/environment/.state/sockets
if [[ -L $sockets ]]; then
  export OMUNCULUS_DEPLOY
  OMUNCULUS_DEPLOY=$(readlink -f "$sockets")
fi
# Its logins, homologation's and production's, from the keys its
# environment made, unless .env gives them.
keys=packs/dream-team/environment/.state/keys
if [[ -f $keys/homologation && -z ${OMUNCULUS_HOMOLOGATION_KEY:-} ]]; then
  export OMUNCULUS_HOMOLOGATION_KEY
  OMUNCULUS_HOMOLOGATION_KEY=$(cat "$keys/homologation")
fi
if [[ -f $keys/production && -z ${OMUNCULUS_PRODUCTION_KEY:-} ]]; then
  export OMUNCULUS_PRODUCTION_KEY
  OMUNCULUS_PRODUCTION_KEY=$(cat "$keys/production")
fi
# The agency's commits are the person's: their git identity, unless .env
# gives one, for the GIT_* variables its [execution] environment names.
name=$(git config user.name || true)
email=$(git config user.email || true)
export GIT_AUTHOR_NAME="${GIT_AUTHOR_NAME:-$name}" GIT_AUTHOR_EMAIL="${GIT_AUTHOR_EMAIL:-$email}"
export GIT_COMMITTER_NAME="${GIT_COMMITTER_NAME:-$name}" GIT_COMMITTER_EMAIL="${GIT_COMMITTER_EMAIL:-$email}"
exec bin/omunculus serve --config dev/server.toml
