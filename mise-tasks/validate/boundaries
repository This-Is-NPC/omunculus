#!/usr/bin/env bash
#MISE description="Check that the apps and the core share only the server's contract"
set -euo pipefail

project_root="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
cd "$project_root"

failed=0
# Prints the tracked lines of `paths` that match `pattern`, under `rule`.
refuse() {
  local rule=$1 pattern=$2
  shift 2
  if git grep -nE "$pattern" -- "$@"; then
    printf 'boundaries: %s\n' "$rule" >&2
    failed=1
  fi
}

refuse "an app reads the core's code, config or store" \
  '(^|[^.[:alnum:]_])(lib|priv)/|omunculus\.toml|\.omunculus/' apps
refuse "the core names an app" 'apps/' lib priv
refuse "the kit's ui imports its client" 'import "\.\./client|kit/client' apps/kit/ui
# Quickshell imports only from within the folder an app runs, so another
# app or the kit can be reached only through a link or a path that leaves it.
refuse "an app or the kit imports from outside its folder" 'import "([^"]*/)?\.\./' apps
links=$(git ls-files -s apps | awk '$1 == "120000" { print $4 }')
for link in $links; do
  [[ $link == apps/*/kit && $link != apps/kit/* && $(git cat-file -p ":$link") == ../kit ]] && continue
  printf '%s\nboundaries: a link in apps/ other than an app'"'"'s kit link\n' "$link" >&2
  failed=1
done
exit $failed
