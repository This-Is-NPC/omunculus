min_usage_version "1.0.0"

name "Omunculus"

bin "omunculus"

version "0.1.0"

about "Coding-agent harness: a directory, an instruction, files change."

long_about "Omunculus is a BEAM coding-agent harness. The CLI opens one session against a directory, talks to an OpenAI-compatible chat endpoint, and applies filesystem tools until the model halts. It does not commit, and it does not speak Anthropic Messages."

default_subcommand "run"

flag "-v --verbose" help="Print every round and tool transition to stderr" env="OMUNCULUS_VERBOSE" global=#true

flag "-h" help="Print help"

flag "--help" help="Print help"

flag "-V --version" help="Print version"




cmd "benchmark" {
  help "Measure concurrent actors, resident agent trees, or HTTP load"
  long_help "actor-density measures a provider-free Agent state plateau in the current BEAM runtime. agent-tree is a synthetic provider-free resident tree stress benchmark: nodes are created in waves and ancestors remain blocked at round_started. http-load drives the external Rust stub through a dedicated Finch pool. RSS and CPU scheduler limits are soft benchmark controls; --cpu-limit changes BEAM schedulers_online only and is restored after the run, not a cgroup or physical CPU quota. Durable trees are documented in docs/to-be/execution-model.md and are not implemented."
  flag "--scenario <scenario>" help="Scenario: actor-density, agent-tree, or http-load" default="actor-density"
  flag "--max-agents <n>" help="Maximum actor-density level target"
  flag "--max-trees <n>" help="Maximum resident agent-tree count"
  flag "--tree-shape <widths>" help="Agent-tree widths by depth (positive multiples)" default="1,1,2,4"
  flag "--tree-mode <mode>" help="Agent-tree mode: resident (durable is documented in docs/to-be/execution-model.md)" default="resident"
  flag "--memory-limit <size>" help="Soft RSS ceiling (K/M/G, base 1024)"
  flag "--provider <provider>" help="Provider for config validation: stub or real" default="stub"
  flag "--model <model>" help="Model id override"
  flag "--tools <tools>" help="Tools: none or counter" default="none"
  flag "--rounds <n>" help="Agent round budget" default="1"
  flag "--stub-delay-ms <n>" help="Stub response delay in milliseconds" default="0"
  flag "--payload-bytes <n>" help="Instruction/request payload size" default="0"
  flag "--step <n>" help="Linear ramp increment; tree ramps by trees"
  flag "--sample-ms <n>" help="RSS sampling interval" default="100"
  flag "--http-concurrency <n>" help="Dedicated HTTP pool size" default="1"
  flag "--cpu-limit <n>" help="Soft BEAM schedulers_online limit (restored after run)"
  flag "--live" help="Render live progress when attached to a TTY"
  flag "--no-live" help="Use append-only progress"
  flag "--json <path>" help="Write the final summary as JSON"
}

cmd "config" {
  help "Validate configuration"
  long_help "check loads the configuration and validates [[interceptors]] and [[automations]] against the event catalog and the loaded modules."
  arg "<action>" help="check"
  flag "--config <file>" help="Config file to validate"
}

cmd "emit" {
  help "Append an injectable command to a durable EVENTS log"
  long_help "Only command types marked injectable in the catalog are accepted. The Event Core validates the payload, assigns identity and sequence, and prints the stored envelope as JSON."
  arg "<type>" help="Command type from the catalog marked injectable"
  flag "--db <file>" help="SQLite file with the EVENTS log"
  flag "--session <file>" help="Session SQLite file (default: ~/.omunculus/session.sqlite3)" env="OMUNCULUS_SESSION"
  flag "--payload <json>" help="Payload as a JSON object"
  flag "--request-id <id>" help="Fill emit fields from an open permission.requested"
  flag "--idempotency-key <key>" help="Stable key so retries do not duplicate the command"
  flag "--correlation-id <id>" help="Join an existing correlation"
  flag "--work-item-id <id>" help="Target work item (default: new)"
}

cmd "events" {
  help "Read the event catalog or follow the EVENTS log"
  long_help "catalog renders the event catalog module as a table. follow reads EVENTS in sequence order as NDJSON, one envelope per line, and keeps polling the file unless --once is given."
  arg "<action>" help="catalog or follow"
  flag "--db <file>" help="SQLite file with the EVENTS log (follow)"
  flag "--session <file>" help="Session SQLite file (default: ~/.omunculus/session.sqlite3)" env="OMUNCULUS_SESSION"
  flag "--types <types>" help="Only these event types (follow)"
  flag "--after <seq>" help="Start after this sequence (follow)" default="0"
  flag "--once" help="Print what exists and exit instead of following"
}

cmd "help" {
  help "Print this message or the help of the given subcommand(s)"
  arg "[command]" help="Command to describe"
}

cmd "inbox" {
  help "List open permission requests and unread task results"
  long_help "Projects open permission.requested envelopes and unread root task.completed results from COMMENTS. reply and read append injectable commands to the session log."
  arg "[action]" help="reply or read (default: list)"
  arg "[id]" help="request_id for reply or comment id for read"
  arg "[text]..." help="Response text for reply" var_min=0
  flag "--db <file>" help="Session SQLite path (default: ~/.omunculus/session.sqlite3)"
  flag "--session <file>" help="Session SQLite file (default: ~/.omunculus/session.sqlite3)" env="OMUNCULUS_SESSION"
  flag "--config <file>" help="Config file for permanent grants"
  flag "--grant" help="Grant the permission request"
  flag "--deny" help="Deny the permission request"
  flag "--permanent" help="Permanent grant (updates workspace policy)"
  flag "--reason <text>" help="Denial reason"
}

cmd "monkey-job" {
  help "Run a diagnostic prompt with an optional tool set"
  long_help "Run the normal agent loop from the current directory while explicitly controlling which tools the model can see and how long tool results remain pending."
  arg "<instruction>..." help="Diagnostic instruction sent to the model unchanged" var_min=1
  flag "--tools <tools>" help="Tool names exposed to the model (default: none)"
  flag "--delay <duration>" help="Delay every tool result"
  flag "--increment <number>" help="Counter increment (requires --tools counter)"
  flag "--model <model>" help="Model id" env="OMUNCULUS_MODEL"
  flag "--max-turns <n>" help="Round budget" env="OMUNCULUS_MAX_TURNS" default="32"
  flag "--base-url <url>" help="OpenAI-compatible base URL" env="OMUNCULUS_BASE_URL"
  flag "--api-key <key>" help="API key (also read from OMUNCULUS_API_KEY by the CLI)"
  flag "--config <file>" help="Config file used for the diagnostic run"
  flag "--json-events" help="Write one JSON event per line to stderr instead of the TTY reporter"
}

cmd "run" {
  help "Run the agent on a directory"
  long_help "Canonicalize <dir>, load presets from omunculus.toml (project over ~/.omunculus/config.toml), and loop AskModel ↔ tools until halt. Does not commit. Flags override the environment; the environment overrides config; config overrides defaults."
  arg "<dir>" help="Working directory (the worktree)"
  arg "<instruction>..." help="What the agent should do" var_min=1
  flag "--preset <preset>" help="Named preset from config" env="OMUNCULUS_PRESET"
  flag "--profile <profile>" help="Named profile from config (alias of --preset; wins if both are set)"
  flag "--tools <tools>" help="Allowlist of tool names (comma-separated)"
  flag "--model <model>" help="Model id" env="OMUNCULUS_MODEL"
  flag "--max-turns <n>" help="Turn budget" env="OMUNCULUS_MAX_TURNS" default="32"
  flag "--base-url <url>" help="OpenAI-compatible base URL" env="OMUNCULUS_BASE_URL"
  flag "--api-key <key>" help="API key (also read from OMUNCULUS_API_KEY by the CLI)"
  flag "--config <file>" help="Config file (overrides <dir>/omunculus.toml)"
  flag "--json-events" help="Write one JSON event per line to stderr instead of the TTY reporter"
}

cmd "send" {
  help "Submit an instruction to a session"
  long_help "Reuses the resident session executor and waits for the root task.completed unless --detach is set. Commands and results are durable in EVENTS."
  arg "<instruction>..." help="Task instruction" var_min=1
  flag "--db <file>" help="Session SQLite path (default: ~/.omunculus/session.sqlite3)"
  flag "--session <file>" help="Session SQLite file (default: ~/.omunculus/session.sqlite3)" env="OMUNCULUS_SESSION"
  flag "--profile <profile>" help="Named profile from config"
  flag "--preset <preset>" help="Named preset from config (alias of --profile)"
  flag "--workspace <id>" help="Target workspace id on the request"
  flag "--provider <provider>" help="chat uses the configured model; fake uses deterministic scripts"
  flag "--model <model>" help="Model id" env="OMUNCULUS_MODEL"
  flag "--base-url <url>" help="OpenAI-compatible endpoint" env="OMUNCULUS_BASE_URL"
  flag "--api-key <key>" help="API key (also read from OMUNCULUS_API_KEY by the CLI)"
  flag "--tools <tools>" help="Narrow the profile tool list"
  flag "--max-turns <n>" help="Maximum model turns per Run"
  flag "--config <file>" help="Config file"
  flag "--detach" help="Append task.requested and return without waiting"
}

cmd "session" {
  help "Create or list durable sessions"
  long_help "create opens a session SQLite log and appends session.created. list prints session_id values from existing logs."
  arg "<action>" help="create, resume or list"
  arg "[name]" help="Session id for create (generated when omitted)"
  flag "--db <file>" help="Session SQLite path (default: ~/.omunculus/session.sqlite3)"
  flag "--session <file>" help="Session SQLite file (default: ~/.omunculus/session.sqlite3)" env="OMUNCULUS_SESSION"
}

cmd "workspace" {
  help "Attach or detach a configured workspace"
  long_help "attach appends workspace.attached with roots and teams from config. detach appends workspace.detached."
  arg "<action>" help="attach or detach"
  arg "<name>" help="Workspace id from [workspaces.*]"
  flag "--db <file>" help="Session SQLite path (default: ~/.omunculus/session.sqlite3)"
  flag "--session <file>" help="Session SQLite file (default: ~/.omunculus/session.sqlite3)" env="OMUNCULUS_SESSION"
  flag "--config <file>" help="Config file (attach)"
}
