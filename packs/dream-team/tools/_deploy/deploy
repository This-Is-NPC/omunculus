#!/usr/bin/env python3
"""The deploy tools, provider-neutral. Each reads the workspace's deploy.toml
(app, port, env: see the pack's README) and has the configured provider act on
the app of the workspace's root. The provider is the executable
providers/$OMUNCULUS_DEPLOY_PROVIDER beside this script; there is no default.

Apps are named after the root: <app>-<id>-hml in the preview environment and
<app>-<id> in production, <id> the first six hex digits of the root's SHA-256,
so each project, and each conversation working in a folder of its own,
publishes apps of its own.

`preview` and `promote` conclude their stage: the answer chains a comment with
the address and continue. `status`, `logs` and `destroy` act on the preview.
Usage: deploy preview|status|logs|promote|destroy, the call's JSON on stdin.

Provider contract: `<provider> <operation>` (deploy, promote, status, logs,
destroy) with, on stdin, {"environment": "preview"|"production", "app",
"source" (promote: the preview app), "root", "port", "env", "lines" (logs)};
on stdout {"ok", "output", "address"}. Its output never names the provider."""

import hashlib
import json
import os
import pathlib
import re
import subprocess
import sys
import tomllib

NAME = re.compile(r"[a-z][a-z0-9-]{1,40}")
VARIABLE = re.compile(r"[A-Z_][A-Z0-9_]*")
PROVIDER = re.compile(r"[a-z][a-z0-9_-]*")


def answer(ok, output, chain=()):
    json.dump({"ok": ok, "output": output, "emit": [], "chain": list(chain)}, sys.stdout)
    sys.stdout.write("\n")
    sys.exit(0)


def conclude(output, report):
    answer(True, output, [{"name": "comment", "args": {"body": report}}, {"name": "continue", "args": {}}])


def descriptor(root):
    path = pathlib.Path(root, "deploy.toml")
    if not path.is_file():
        answer(False, 'deploy.toml is missing from the workspace: write it, with app = "<name>" (lowercase letters, digits and dashes), port = <the port the image serves> and, optionally, env = ["<NAME>", ...] (the variables the app reads), and commit it')
    try:
        spec = tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError as error:
        answer(False, f"deploy.toml is not valid TOML: {error}")
    unknown = sorted(set(spec) - {"app", "port", "env"})
    if unknown:
        answer(False, "deploy.toml has keys the contract does not define: " + ", ".join(unknown))
    app, port, env = spec.get("app"), spec.get("port"), spec.get("env", [])
    if not isinstance(app, str) or not NAME.fullmatch(app):
        answer(False, "deploy.toml: app must be lowercase letters, digits and dashes, starting with a letter")
    if isinstance(port, bool) or not isinstance(port, int) or not 1 <= port <= 65535:
        answer(False, "deploy.toml: port must be an integer from 1 to 65535")
    if not isinstance(env, list) or not all(isinstance(n, str) and VARIABLE.fullmatch(n) for n in env):
        answer(False, "deploy.toml: env must be a list of variable names in capitals, digits and underscores")
    return {"app": app, "port": port, "env": env}


def provider():
    name = os.environ.get("OMUNCULUS_DEPLOY_PROVIDER", "")
    if not PROVIDER.fullmatch(name):
        answer(False, "no deploy provider is configured")
    path = pathlib.Path(__file__).resolve().parent / "providers" / name
    if not os.access(path, os.X_OK):
        answer(False, f"the deploy provider {name} does not exist")
    return str(path)


def act(operation, request):
    done = subprocess.run([provider(), operation], input=json.dumps(request), capture_output=True, text=True)
    try:
        result = json.loads(done.stdout)
        return result["ok"], result["output"], result.get("address")
    except (ValueError, KeyError):
        answer(False, "the deploy provider failed: " + (done.stderr.strip() or "it gave no answer"))


def commit_of(root):
    done = subprocess.run(["git", "-C", root, "rev-parse", "--short", "HEAD"], capture_output=True, text=True)
    if done.returncode != 0:
        answer(False, "the workspace has no commit to publish: commit it first")
    return done.stdout.strip()


def main():
    operation = sys.argv[1]
    call = json.load(sys.stdin)
    args = call.get("args") or {}
    root = (call.get("roots") or [None])[0]
    if not root:
        answer(False, "no workspace to publish from")
    spec = descriptor(root)
    suffix = "-" + hashlib.sha256(root.encode()).hexdigest()[:6]
    preview, production = spec["app"] + suffix + "-hml", spec["app"] + suffix
    request = dict(spec, root=root)

    if operation == "preview":
        commit = commit_of(root)
        ok, output, address = act("deploy", dict(request, environment="preview", app=preview))
        if not ok:
            answer(False, f"publishing to the preview failed:\n{output}")
        conclude(f"published to the preview at {address}\n{output}", f"Published to the preview at {address}: commit {commit}.")
    elif operation == "promote":
        ok, output, address = act("promote", dict(request, environment="production", app=production, source=preview))
        if not ok:
            answer(False, f"promoting to production failed:\n{output}")
        conclude(f"promoted to production at {address}\n{output}",
                 f"Promoted to production at {address}: the image the person saw in the preview and approved by granting promote.")
    elif operation == "status":
        ok, output, _ = act("status", dict(request, environment="preview", app=preview))
        answer(ok, output)
    elif operation == "logs":
        lines = args.get("lines", 100)
        if isinstance(lines, bool) or not isinstance(lines, int) or not 1 <= lines <= 1000:
            answer(False, "lines must be an integer from 1 to 1000")
        ok, output, _ = act("logs", dict(request, environment="preview", app=preview, lines=lines))
        answer(ok, output)
    else:
        ok, output, _ = act("destroy", dict(request, environment="preview", app=preview))
        answer(ok, output)


main()
