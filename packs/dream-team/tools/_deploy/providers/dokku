#!/usr/bin/env python3
"""The Dokku provider of the deploy tools (see ../deploy for the contract).
The preview environment is the homologation instance, production the
production instance; each is reached through the unix socket of that instance
under $OMUNCULUS_DEPLOY, with the key its secret DEPLOY_KEY holds, loaded into
an ssh-agent of its own that ends with the call: no network, and no key on
disk. A success answers only the address; a failure keeps the build's own
lines, without the push's. The messages it writes never name the provider;
what an app prints, its log, is passed on as it is. Any failure is answered as {"ok": false}.
Usage: dokku deploy|promote|status|logs|destroy, the request's JSON on stdin."""

import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time

INSTANCES = {"preview": "homologation", "production": "production"}
PORTS = {"homologation": 8080, "production": 9080}
# Bounds, in seconds: the agent's socket, a command, an image build.
AGENT_WAIT = 5
SHORT = 60
BUILD = 600
UNREACHABLE = "the deploy environment is not reachable: is it up?"


class Failure(Exception):
    """A failure whose message is fit to show."""


def ssh_command(instance):
    socket = os.path.join(os.environ.get("OMUNCULUS_DEPLOY", ""), instance + ".sock")
    if not os.path.exists(socket):
        raise Failure(UNREACHABLE)
    if len(os.fsencode(socket)) > 107:
        raise Failure("the deploy environment's address is longer than a unix socket address holds: point OMUNCULUS_DEPLOY at a shorter path")
    return [
        "ssh", "-F", "/dev/null",
        "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
        "-o", "LogLevel=ERROR", "-o", "ConnectTimeout=10",
        "-o", f"ProxyCommand=socat - UNIX-CONNECT:{shlex.quote(socket)}",
    ]


def with_agent(run):
    with open(os.environ["DEPLOY_KEY_FILE"]) as file:
        key = file.read().strip() + "\n"
    with tempfile.TemporaryDirectory() as directory:
        sock = os.path.join(directory, "agent")
        agent = subprocess.Popen(
            ["ssh-agent", "-D", "-a", sock], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
        try:
            deadline = time.monotonic() + AGENT_WAIT
            while not os.path.exists(sock):
                if time.monotonic() > deadline:
                    raise Failure("the deploy credentials could not be loaded: the agent holding them did not start")
                time.sleep(0.01)
            env = dict(os.environ, SSH_AUTH_SOCK=sock)
            added = subprocess.run(["ssh-add", "-q", "-"], input=key, text=True, env=env, capture_output=True, timeout=SHORT)
            if added.returncode != 0:
                raise Failure("the deploy credentials could not be loaded")
            return run(env)
        finally:
            agent.terminate()
            agent.wait()


def run(command, env, timeout=SHORT):
    try:
        done = subprocess.run(command, env=env, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return 124, f"timed out after {timeout} s"
    return done.returncode, (done.stdout + done.stderr).strip()


def remote(instance, args, env, timeout=SHORT):
    """A command of the instance: a failure to reach it is a Failure, not an answer."""
    code, said = run(ssh_command(instance) + [f"dokku@{instance}"] + args, env, timeout)
    if code == 255:
        raise Failure(UNREACHABLE)
    if code == 124 and timeout == SHORT:
        raise Failure("the deploy environment did not answer in time")
    return code, said


def tidy(text):
    """The provider's own noise out of what a command printed: its address and the connection's lines."""
    kept = [re.sub(r"^remote: ?", "", line) for line in text.splitlines()
            if not re.match(r"(ssh|Warning|To |hint|error: failed to push)|\s*! \[", line)]
    return re.sub(r"dokku@\S+", "the deploy environment", "\n".join(kept))


def tail(text, lines=15):
    return "\n".join(tidy(text).splitlines()[-lines:])


def address(instance, app):
    return f"http://{app}.{instance}.localhost:{PORTS[instance]}"


def exists(instance, app, env):
    return remote(instance, ["apps:exists", app], env)[0] == 0


def prepare(request, instance, app, env):
    """The app exists and maps port 80 to the descriptor's port."""
    if not exists(instance, app, env):
        code, said = remote(instance, ["apps:create", app], env)
        if code != 0:
            raise Failure(tail(said))
    port_map = f"http:80:{request['port']}"
    if port_map not in remote(instance, ["ports:report", app, "--ports-map"], env)[1].split():
        code, said = remote(instance, ["ports:set", app, port_map], env, BUILD)
        if code != 0:
            raise Failure(tail(said))


def deploy(request, instance, app):
    def push(env):
        env = dict(env, GIT_SSH_COMMAND=shlex.join(ssh_command(instance)))
        return run(["git", "-C", request["root"], "push", "--force", f"dokku@{instance}:{app}", f"{request['commit']}:refs/heads/main"], env, BUILD)

    with_agent(lambda env: prepare(request, instance, app, env))
    code, said = with_agent(push)
    # A push cut short leaves the app's deploy lock behind; each root
    # publishes its own app, one release at a time, so the lock is stale.
    if code != 0 and "deploy lock in place" in said:
        with_agent(lambda env: remote(instance, ["apps:unlock", app], env))
        code, said = with_agent(push)
    if code != 0:
        raise Failure(tail(said))
    return True, "", address(instance, app)


def promote(request, instance, app):
    def release(env):
        prepare(request, instance, app, env)
        code, said = remote(instance, ["git:from-image", app, f"dokku/{request['source']}:latest"], env, BUILD)
        # The same image again: rebuild production from it.
        if code != 0 and "No changes detected" in said:
            code, said = remote(instance, ["ps:rebuild", app], env, BUILD)
        return code, said

    code, said = with_agent(release)
    if code != 0:
        raise Failure(tail(said))
    return True, "", address(instance, app)


def status(request, instance, app):
    def report(env):
        if not exists(instance, app, env):
            return None
        return remote(instance, ["ps:report", app], env)[1]

    said = with_agent(report)
    if said is None:
        return True, f"{app} is not deployed", None
    state = dict(re.findall(r"^\s*(Deployed|Running):\s*(\S+)", said, re.M | re.I))
    deployed, running = state.get("Deployed") == "true", state.get("Running") == "true"
    return True, f"{app} is deployed: {str(deployed).lower()}, running: {str(running).lower()}, at {address(instance, app)}", None


def logs(request, instance, app):
    def read(env):
        if not exists(instance, app, env):
            return None
        return remote(instance, ["logs", app, "-n", str(request["lines"])], env)

    result = with_agent(read)
    if result is None:
        return True, f"{app} is not deployed", None
    code, said = result
    return code == 0, said if code == 0 else tail(said), None


def destroy(request, instance, app):
    def remove(env):
        if not exists(instance, app, env):
            return 0, None
        return remote(instance, ["apps:destroy", app, "--force"], env, BUILD)

    code, said = with_agent(remove)
    if code != 0:
        raise Failure(tail(said))
    return True, f"{app} is not deployed: nothing to destroy" if said is None else f"{app} destroyed", None


def main():
    try:
        request = json.load(sys.stdin)
        operations = {"deploy": deploy, "promote": promote, "status": status, "logs": logs, "destroy": destroy}
        ok, output, location = operations[sys.argv[1]](request, INSTANCES[request["environment"]], request["app"])
    except Failure as failure:
        ok, output, location = False, str(failure), None
    except Exception:
        ok, output, location = False, "the deploy provider failed unexpectedly", None
    json.dump({"ok": ok, "output": output, "address": location}, sys.stdout)
    sys.stdout.write("\n")


main()
