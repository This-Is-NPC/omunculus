#!/usr/bin/env python3
"""The Dokku provider of the deploy tools (see ../deploy for the contract).
The preview environment is the homologation instance, production the
production instance; each is reached through the unix socket of that instance
under $OMUNCULUS_DEPLOY, with the key its secret DEPLOY_KEY holds, loaded into
an ssh-agent of its own that ends with the call: no network, and no key on
disk. What it says never names the provider. Usage: dokku
deploy|promote|status|logs|destroy, the request's JSON on stdin."""

import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time

INSTANCES = {"preview": "homologation", "production": "production"}
PORTS = {"homologation": 8080, "production": 9080}


def answer(ok, output, address=None):
    text = re.sub(r"(?i)dokku", "deploy", output)
    json.dump({"ok": ok, "output": text, "address": address}, sys.stdout)
    sys.stdout.write("\n")
    sys.exit(0)


def ssh_command(instance):
    socket = os.path.join(os.environ.get("OMUNCULUS_DEPLOY", ""), instance + ".sock")
    if not os.path.exists(socket):
        answer(False, "the deploy environment is not reachable: is it up?")
    if len(os.fsencode(socket)) > 107:
        answer(False, "the deploy environment's address is longer than a unix socket address holds: point OMUNCULUS_DEPLOY at a shorter path")
    return [
        "ssh", "-F", "/dev/null",
        "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
        "-o", "LogLevel=ERROR", "-o", f"ProxyCommand=socat - UNIX-CONNECT:{socket}",
    ]


def with_agent(run):
    key = open(os.environ["DEPLOY_KEY_FILE"]).read().strip() + "\n"
    with tempfile.TemporaryDirectory() as directory:
        sock = os.path.join(directory, "agent")
        agent = subprocess.Popen(
            ["ssh-agent", "-D", "-a", sock], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
        try:
            while not os.path.exists(sock):
                time.sleep(0.01)
            env = dict(os.environ, SSH_AUTH_SOCK=sock)
            subprocess.run(["ssh-add", "-q", "-"], input=key, text=True, env=env, check=True)
            return run(env)
        finally:
            agent.terminate()


def run(command, env, cwd=None):
    done = subprocess.run(command, env=env, cwd=cwd, capture_output=True, text=True)
    return done.returncode, (done.stdout + done.stderr).strip()


def tail(text, lines=15):
    return "\n".join(text.splitlines()[-lines:])


def address(instance, app):
    return f"http://{app}.{instance}.localhost:{PORTS[instance]}"


def prepare(request, instance, app, env):
    """The app exists, maps port 80 to the descriptor's port and has the variables it names."""
    dokku = ssh_command(instance) + [f"dokku@{instance}"]
    if run(dokku + ["apps:exists", app], env)[0] != 0:
        status, said = run(dokku + ["apps:create", app], env)
        if status != 0:
            return status, said
    port_map = f"http:80:{request['port']}"
    if port_map not in run(dokku + ["ports:report", app, "--ports-map"], env)[1].split():
        status, said = run(dokku + ["ports:set", app, port_map], env)
        if status != 0:
            return status, said
    keys = run(dokku + ["config:keys", app], env)[1].split()
    missing = [name for name in request["env"] if name not in keys]
    if missing:
        return 1, "the environment lacks values for: " + ", ".join(missing)
    return 0, ""


def deploy(request, instance, app):
    def push(env):
        env = dict(env, GIT_SSH_COMMAND=shlex.join(ssh_command(instance)))
        return run(["git", "-C", request["root"], "push", "--force", f"dokku@{instance}:{app}", "HEAD:refs/heads/main"], env)

    status, said = with_agent(lambda env: prepare(request, instance, app, env))
    if status != 0:
        answer(False, tail(said))
    status, said = with_agent(push)
    # A push cut short leaves the app's deploy lock behind; each root
    # publishes its own app, one release at a time, so the lock is stale.
    if status != 0 and "deploy lock in place" in said:
        unlock = ssh_command(instance) + [f"dokku@{instance}", "apps:unlock", app]
        with_agent(lambda env: run(unlock, env))
        status, said = with_agent(push)
    if status != 0:
        answer(False, tail(said))
    answer(True, tail(said, 5), address(instance, app))


def promote(request, instance, app):
    def release(env):
        status, said = prepare(request, instance, app, env)
        if status != 0:
            return status, said
        dokku = ssh_command(instance) + [f"dokku@{instance}"]
        status, said = run(dokku + ["git:from-image", app, f"dokku/{request['source']}:latest"], env)
        # The same image again: rebuild production from it.
        if status != 0 and "No changes detected" in said:
            status, said = run(dokku + ["ps:rebuild", app], env)
        return status, said

    status, said = with_agent(release)
    if status != 0:
        answer(False, tail(said))
    answer(True, tail(said, 5), address(instance, app))


def status(request, instance, app):
    def report(env):
        dokku = ssh_command(instance) + [f"dokku@{instance}"]
        if run(dokku + ["apps:exists", app], env)[0] != 0:
            return None
        return run(dokku + ["ps:report", app], env)[1]

    said = with_agent(report)
    if said is None:
        answer(True, f"{app} is not deployed")
    state = dict(re.findall(r"^\s*(Deployed|Running):\s*(\S+)", said, re.M | re.I))
    deployed, running = state.get("Deployed") == "true", state.get("Running") == "true"
    answer(True, f"{app} is deployed: {str(deployed).lower()}, running: {str(running).lower()}, at {address(instance, app)}")


def logs(request, instance, app):
    def read(env):
        return run(ssh_command(instance) + [f"dokku@{instance}", "logs", app, "-n", str(request["lines"])], env)

    code, said = with_agent(read)
    answer(code == 0, said)


def destroy(request, instance, app):
    def remove(env):
        return run(ssh_command(instance) + [f"dokku@{instance}", "apps:destroy", app, "--force"], env)

    code, said = with_agent(remove)
    answer(code == 0, f"{app} destroyed" if code == 0 else tail(said))


def main():
    request = json.load(sys.stdin)
    instance = INSTANCES[request["environment"]]
    operations = {"deploy": deploy, "promote": promote, "status": status, "logs": logs, "destroy": destroy}
    operations[sys.argv[1]](request, instance, request["app"])


main()
