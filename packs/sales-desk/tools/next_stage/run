#!/usr/bin/env python3
"""The seller's way to move a client's request to the next stage of the
workflow sale: refused until the stage the work is in holds, then the
report as a comment on the work and continue. The proposal is the artifact
`proposal-<work id>` the proposal tool wrote: the stages check its data,
whatever language the client reads it in."""

import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "_proposal"))
import proposal  # noqa: E402


def refuse(stage, missing):
    raise proposal.Refusal(f"stage {stage} does not hold yet: {missing}. Do that first, then call next_stage again.")


def filled(data, paths):
    """The paths of `data`, dotted, that hold nothing yet."""
    return [path for path in paths if not str(proposal.lookup(data, path) or "").strip()]


def body(event):
    data = (event or {}).get("body")
    if isinstance(data, str):
        try:
            return json.loads(data)
        except ValueError:
            return {}
    return data or {}


def run(call):
    view = call.get("view") or {}
    work = view.get("work") or {}
    stage = work.get("stage")
    report = str((call.get("args") or {}).get("report") or "").strip()
    if not report:
        raise proposal.Refusal("report required")
    if not stage:
        raise proposal.Refusal("next_stage moves a request of the workflow sale; this run has none")

    data = proposal.current(view, work["id"])
    if data is None:
        refuse(stage, "write the proposal with the proposal tool")

    if stage == "qualify":
        missing = filled(data, ["business", "city", "audience", "decider", "budget_timing", "problem",
                                "content.texts", "content.products", "content.contacts"])
        pages = proposal.lookup(data, "scope.pages")
        if not (proposal.is_text_list(pages) and pages):
            missing.append("scope.pages")
        if missing:
            refuse(stage, "ask the client and write with the proposal tool what they said — that they left it to us, or do not have it, is an answer too: " + ", ".join(missing))
    elif stage == "design":
        if proposal.lookup(data, "design.state") not in proposal.DESIGN_STATES:
            refuse(stage, "design.state is approved, once the client approved the preview (with its address in design.address), or waived, when they do not want one")
    elif stage == "assess":
        if filled(data, ["assessment.work", "assessment.answer"]):
            refuse(stage, "ask the builders for an assessment and write its work id (assessment.work) and their answer (assessment.answer) with the proposal tool")
    elif stage == "propose":
        if "price" not in data or data.get("status") != "accepted":
            refuse(stage, "give the client the price, and set the status accepted once they accept; the owner's approval is asked at stage owner, after this one")
    elif stage == "owner":
        cause = view.get("cause") or {}
        if cause.get("type") != "reply" or body(cause).get("option") != "approve":
            refuse(stage, "ask the owner with ask, to owner, the options approve and deny; call next_stage in the run their approve opens")
    elif stage == "build":
        builds = [child for child in view.get("children") or []
                  if child.get("state") == "done" and not (child.get("goal") or "").lower().startswith("assessment only")]
        if not builds:
            refuse(stage, "send the builders the build as a work naming their administrator, and call next_stage once it comes back done")

    return "", [], [{"name": "comment", "args": {"body": report}}, {"name": "continue", "args": {}}]


proposal.tool(run)
