#!/usr/bin/env python3
"""The way to move a client's request to the next stage of its workflow: the
seller's, sale, or the project manager's, engagement. Refused until the stage
the work is in holds, then the report as a comment on the work and continue.
The proposal is the artifact `proposal-<work id>` the proposal tool wrote,
whose id is the project manager's work: the stages check its data, whatever
language the client reads it in."""

import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "_proposal"))
import proposal  # noqa: E402


def refuse(stage, missing):
    raise proposal.Refusal(f"stage {stage} does not hold yet: {missing}. Do that first, then call next_stage again.")


def filled(data, paths):
    """The paths of `data`, dotted, that hold nothing yet."""
    return [path for path in paths if not str(proposal.lookup(data, path) or "").strip()]


def body(event):
    data = (event or {}).get("body")
    if isinstance(data, str):
        try:
            return json.loads(data)
        except ValueError:
            return {}
    return data or {}


def done(children, assignee):
    return [child for child in children if child.get("assignee") == assignee and child.get("state") == "done"]


def run(call):
    view = call.get("view") or {}
    work = view.get("work") or {}
    stage = work.get("stage")
    report = str((call.get("args") or {}).get("report") or "").strip()
    if not report:
        raise proposal.Refusal("report required")
    if not stage:
        raise proposal.Refusal("next_stage moves a client's request through the stages of its workflow; this run has none")

    data = proposal.current(view, proposal.engagement(work))
    if data is None:
        refuse(stage, "write the proposal with the proposal tool")
    children = view.get("children") or []

    if stage == "qualify":
        missing = filled(data, ["business", "city", "audience", "decider", "budget_timing", "problem",
                                "content.texts", "content.products", "content.contacts"])
        pages = proposal.lookup(data, "scope.pages")
        if not (proposal.is_text_list(pages) and pages):
            missing.append("scope.pages")
        if missing:
            refuse(stage, "ask the client and write with the proposal tool what they said — that they left it to us, or do not have it, is an answer too: " + ", ".join(missing))
    elif stage == "estimate":
        if filled(data, ["assessment.answer"]):
            refuse(stage, "ask the project manager with ask, to pm, whether the scope can be built and in what time, and write its answer (assessment.answer) with the proposal tool")
    elif stage == "propose":
        try:
            proposal.check_sendable(data)
        except proposal.Refusal as refusal:
            refuse(stage, str(refusal))
        if "price" not in data or data.get("status") != "accepted":
            refuse(stage, "give the client the price, and set the status accepted once they accept; the owner's approval is asked at stage signoff, after this one")
    elif stage == "signoff":
        cause = view.get("cause") or {}
        if cause.get("type") != "reply" or body(cause).get("option") != "approve":
            refuse(stage, "ask the owner with ask, to owner, the options approve and deny; call next_stage in the run their approve opens")
        if data.get("status") != "approved":
            refuse(stage, "set the status approved with the proposal tool")
    elif stage == "sale":
        if data.get("status") == "refused":
            refuse(stage, "the client refused the proposal: tell them it is closed and call break")
        if not done(children, "seller") or data.get("status") != "approved":
            refuse(stage, "call next_stage once the seller's sale work came back done with the proposal approved")
    elif stage == "design":
        state = proposal.lookup(data, "design.state")
        if state not in proposal.DESIGN_STATES:
            refuse(stage, "design.state is approved, once the client approved the preview (with its address in design.address), or waived, when the client answered the front desk's question that they do not want one (their answer in design.client_answer)")
        if state == "approved" and filled(data, ["design.address"]):
            refuse(stage, "write the preview's address in design.address")
        if state == "waived" and filled(data, ["design.client_answer"]):
            refuse(stage, "only the client waives the preview: write their answer in design.client_answer")
    elif stage == "build":
        if not [child for child in done(children, "administrator") if not (child.get("goal") or "").lower().startswith("assessment only")]:
            refuse(stage, "hand the dev team the build as a work naming its administrator, and call next_stage once it came back done")
        if filled(data, ["delivery.address"]) or str(proposal.lookup(data, "delivery.accepted") or "").strip().lower() != "accepted":
            refuse(stage, "the client must accept the built site at its homologation address before it goes to production: ask them, and write the address (delivery.address) and delivery.accepted as accepted with the proposal tool, once they accepted")
    elif stage == "handover":
        if filled(data, ["delivery.production"]):
            refuse(stage, "write the production address in delivery.production once the site is live")
        cause = view.get("cause") or {}
        if cause.get("type") != "reply" or body(cause).get("option") != "works":
            refuse(stage, "tell the client the site is live: ask them, with ask, the options works and problem, giving the production address; call next_stage in the run their works answer opens")

    return "", [], [{"name": "comment", "args": {"body": report}}, {"name": "continue", "args": {}}]


proposal.tool(run)
