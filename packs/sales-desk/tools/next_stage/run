#!/usr/bin/env python3
"""The seller's way to move a client's request to the next stage of the
workflow sale: refused until the stage the work is in holds, then the
report as a comment on the work and continue. The proposal is the file of
quotes/ with the line "Work: <id>" of the call's work."""

import json
import pathlib
import re
import sys


def answer(ok, output, chain=()):
    json.dump({"ok": ok, "output": output, "emit": [], "chain": list(chain)}, sys.stdout)
    sys.stdout.write("\n")
    sys.exit(0)


def refuse(stage, missing):
    answer(False, f"stage {stage} does not hold yet: {missing}. Do that first, then call next_stage again.")


def proposal(root, work_id):
    for path in sorted(pathlib.Path(root, "quotes").glob("*.md")):
        text = path.read_text(errors="replace")
        if re.search(rf"^Work:\s*{re.escape(work_id)}\s*$", text, re.M):
            return path, text
    return None, None


def section(text, title):
    match = re.search(rf"^##\s+{re.escape(title)}\s*$(.*?)(?=^##\s|\Z)", text, re.M | re.S)
    return match.group(1) if match else ""


def value(block, label):
    match = re.search(rf"^-\s*{re.escape(label)}:[ \t]*(.*)$", block, re.M)
    return match.group(1).strip() if match else ""


def filled(block, labels):
    return [label for label in labels if not value(block, label)]


def body(event):
    data = (event or {}).get("body")
    if isinstance(data, str):
        try:
            return json.loads(data)
        except ValueError:
            return {}
    return data or {}


def main():
    call = json.load(sys.stdin)
    view = call.get("view") or {}
    work = view.get("work") or {}
    stage = work.get("stage")
    root = (call.get("roots") or [None])[0]
    report = ((call.get("args") or {}).get("report") or "").strip()
    if not report:
        answer(False, "report required")
    if not stage or not root:
        answer(False, "next_stage moves a request of the workflow sale; this run has none")

    path, text = proposal(root, work["id"])
    if not text:
        refuse(stage, f"write the proposal in quotes/<client-slug>.md from templates/proposal.md, with the line Work: {work['id']}")

    if stage == "qualify":
        missing = filled(section(text, "1. Who they are"), ["Business, city, who the site is for", "Who decides, and the budget and timing they gave (qualification)"])
        missing += filled(section(text, "2. The problem, in their words"), ["What is not working today, and what it costs them"])
        missing += filled(section(text, "Content"), ["Texts", "Products and prices", "Contacts"])
        missing += filled(section(text, "4. Scope"), ["Pages, one per line"])
        if missing:
            refuse(stage, f"ask the client and write in {path.name} what they said — that they left it to us, or do not have it, is an answer too: " + "; ".join(missing))
    elif stage == "design":
        preview = value(section(text, "Design"), "Preview").lower()
        if "approved" not in preview and "not wanted" not in preview:
            refuse(stage, f"the Preview line of ## Design in {path.name} says the address and approved, once the client approved it, or not wanted")
    elif stage == "assess":
        block = section(text, "Builders' assessment")
        if not value(block, "Work id") or not value(block, "Answer"):
            refuse(stage, f"ask the builders for an assessment and write their work id and answer under ## Builders' assessment in {path.name}")
    elif stage == "propose":
        status = re.search(r"^Status:\s*(.*)$", text, re.M)
        if not value(section(text, "6. Price"), "Total") or not status or not status.group(1).startswith("accepted"):
            refuse(stage, f"give the client the price, write the Total, and mark Status accepted, awaiting owner in {path.name} once they accept")
    elif stage == "owner":
        cause = view.get("cause") or {}
        if cause.get("type") != "reply" or body(cause).get("option") != "approve":
            refuse(stage, "ask the owner with ask, to person, the options approve and deny; call next_stage in the run their approve opens")
    elif stage == "build":
        builds = [child for child in view.get("children") or []
                  if child.get("state") == "done" and not (child.get("goal") or "").lower().startswith("assessment only")]
        if not builds:
            refuse(stage, "send the builders the build as a work naming their administrator, and call next_stage once it comes back done")

    answer(True, "", [{"name": "comment", "args": {"body": report}}, {"name": "continue", "args": {}}])


main()
