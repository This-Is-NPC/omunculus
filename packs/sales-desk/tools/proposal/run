#!/usr/bin/env python3
"""The seller's way to write the proposal of the client's request: `fields`
laid over the latest version of the proposal of the call's work, the price
worked out by the desk's rules, and the next versions of the artifact
`proposal` (the data) and of `proposal.md` (the client's document, rendered
from templates/proposal.md). See ../_proposal/proposal.py."""

import datetime
import json
import os
import pathlib
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "_proposal"))
import proposal  # noqa: E402

COMPUTED = ("work", "updated", "price")


def answer(ok, output, emit=()):
    json.dump({"ok": ok, "output": output, "emit": list(emit), "chain": []}, sys.stdout)
    sys.stdout.write("\n")
    sys.exit(0)


def main():
    call = json.load(sys.stdin)
    view = call.get("view") or {}
    args = call.get("args") or {}
    work = view.get("work") or {}
    root = (call.get("roots") or [None])[0]
    if not work.get("id") or not root:
        answer(False, "proposal writes the proposal of a client's request; this run has none")

    fields = args.get("fields")
    if not isinstance(fields, dict):
        answer(False, "fields must be an object")
    computed = [key for key in COMPUTED if key in fields]
    if computed:
        answer(False, f"the desk works out {', '.join(computed)}: leave it out of fields")
    status = fields.get("status")
    if status is not None and status not in proposal.STATUSES:
        answer(False, f"status is one of: {', '.join(proposal.STATUSES)}")

    previous = proposal.latest(view, work["id"]) or {}
    discount = args.get("discount", (previous.get("price") or {}).get("discount", 0))
    if not isinstance(discount, (int, float)) or discount < 0:
        answer(False, "discount is a percentage, zero or more")
    if discount > proposal.MAX_DISCOUNT:
        answer(False, f"the desk gives up to {proposal.MAX_DISCOUNT}% off; a larger discount is the owner's decision, asked with ask")

    template = pathlib.Path(root, "templates", "proposal.md")
    if not template.is_file():
        answer(False, "templates/proposal.md is missing in the workspace")

    data = proposal.merge(previous, fields)
    data["work"] = work["id"]
    data["updated"] = datetime.date.today().isoformat()
    data.setdefault("status", "draft")
    data = proposal.priced(data, discount)

    total = proposal.money(data["price"]["total"]) if "price" in data else "no price yet"
    answer(True, f"proposal saved: status {data['status']}, total {total}",
           proposal.emits(data, template.read_text(encoding="utf-8")))


main()
