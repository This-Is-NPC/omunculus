#!/usr/bin/env python3
"""The seller's way to write the proposal of the client's request: `fields`
laid over the latest version of the proposal of the call's work, the price
worked out by the desk's rules, and the next versions of the artifact
`proposal-<work id>` (the data) and of `proposal-<work id>.md` (the client's
document, rendered from the template beside ../_proposal/proposal.py). A
write built on a version another call has replaced is refused."""

import datetime
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "_proposal"))
import proposal  # noqa: E402


def run(call):
    view = call.get("view") or {}
    args = call.get("args") or {}
    work_id = proposal.engagement(view.get("work") or {})
    if not work_id:
        raise proposal.Refusal("proposal writes the proposal of a client's request; this run has none")

    fields = args.get("fields")
    proposal.validate(fields)

    data = proposal.current(view, work_id) or {}
    data = proposal.merge(data, fields)
    if "discount" in args:
        data["discount"] = proposal.check_discount(args["discount"])
    data["work"] = work_id
    data["updated"] = datetime.date.today().isoformat()
    data.setdefault("status", "draft")
    data = proposal.priced(data)

    total = proposal.money(data["price"]["total"]) if "price" in data else "no price yet"
    note = f"attach the artifact {proposal.document(work_id)} to give the client this version"
    return f"proposal saved: status {data['status']}, total {total}; {note}", proposal.emits(view, work_id, data), []


proposal.tool(run)
