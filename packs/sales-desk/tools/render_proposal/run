#!/usr/bin/env python3
"""Renders the latest version of the proposal of the call's work again, as
the next version of its document, after the template changed. The data is
not touched."""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "_proposal"))
import proposal  # noqa: E402


def run(call):
    view = call.get("view") or {}
    work_id = (view.get("work") or {}).get("id")
    if not work_id:
        raise proposal.Refusal("render_proposal renders the proposal of a client's request; this run has none")

    data = proposal.current(view, work_id)
    if data is None:
        raise proposal.Refusal("there is no proposal of this request yet: write it with proposal")
    return f"{proposal.document(work_id)} rendered from the proposal of {data['updated']}", [proposal.document_emit(view, work_id, data)], []


proposal.tool(run)
