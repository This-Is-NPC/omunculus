#!/usr/bin/env python3
"""CLI login for Cursor: open loginDeepControl, poll, optional API-key exchange."""

import hashlib
import json
import os
import secrets
import sys
import time
import urllib.parse
import uuid

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "_cursor"))
from cursor import EXCHANGE_URL, credential_from, emit, http_json  # noqa: E402

LOGIN_URL = os.environ.get(
    "OMUNCULUS_CURSOR_LOGIN_URL", "https://cursor.com/loginDeepControl"
)
POLL_URL = os.environ.get(
    "OMUNCULUS_CURSOR_POLL_URL", "https://api2.cursor.sh/auth/poll"
)
NO_BROWSER = os.environ.get("OMUNCULUS_CURSOR_NO_BROWSER", "") == "1"
POLL_SECONDS = int(os.environ.get("OMUNCULUS_CURSOR_POLL_SECONDS", "120"))


def read_input():
    raw = sys.stdin.read()
    if not raw.strip():
        return {}
    return json.loads(raw)


def b64url(data):
    import base64

    return base64.urlsafe_b64encode(data).decode("ascii").rstrip("=")


def open_browser(url):
    if NO_BROWSER:
        return
    for opener in ("xdg-open", "open"):
        from shutil import which
        from subprocess import run

        path = which(opener)
        if path:
            run([path, url], check=False, capture_output=True)
            return


def poll(uuid_value, verifier):
    query = urllib.parse.urlencode({"uuid": uuid_value, "verifier": verifier})
    url = POLL_URL + ("&" if "?" in POLL_URL else "?") + query
    deadline = time.time() + POLL_SECONDS
    while time.time() < deadline:
        body = http_json(url)
        if isinstance(body, dict):
            record = credential_from(body, {})
            if record:
                return record
        time.sleep(0.2)
    raise RuntimeError("poll timed out")


def maybe_exchange(record):
    token = record.get("refresh") or record.get("access")
    if not token:
        return record
    try:
        body = http_json(EXCHANGE_URL, method="POST", body={"apiKey": token})
    except RuntimeError:
        return record
    if not isinstance(body, dict):
        return record
    return credential_from(body, record) or record


def main():
    try:
        payload = read_input()
    except json.JSONDecodeError:
        emit(False, "invalid json")
        return
    args = payload.get("args") or {}
    login_uuid = args.get("uuid") or str(uuid.uuid4())
    verifier = args.get("verifier") or secrets.token_urlsafe(32)
    challenge = b64url(hashlib.sha256(verifier.encode("utf-8")).digest())
    query = urllib.parse.urlencode(
        {"challenge": challenge, "uuid": login_uuid, "mode": "login"}
    )
    url = LOGIN_URL + ("&" if "?" in LOGIN_URL else "?") + query
    open_browser(url)
    try:
        record = poll(login_uuid, verifier)
        record = maybe_exchange(record)
        emit(True, json.dumps(record))
    except Exception as error:  # noqa: BLE001 — tool output is the error string
        emit(False, str(error))


if __name__ == "__main__":
    main()
