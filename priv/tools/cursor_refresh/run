#!/usr/bin/env python3
"""Harness refresh for Cursor: exchange the stored key for a fresh access token."""

import json
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "_cursor"))
from cursor import EXCHANGE_URL, credential_from, emit, http_json  # noqa: E402


def main():
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError:
        emit(False, "invalid json")
        return
    view = payload.get("view") or {}
    record = view.get("credential") or {}
    if not isinstance(record, dict):
        emit(False, "missing credential")
        return
    token = record.get("refresh") or record.get("key") or record.get("access")
    if not isinstance(token, str) or not token:
        emit(False, "missing refresh token")
        return
    try:
        body = http_json(EXCHANGE_URL, method="POST", body={"apiKey": token})
        updated = credential_from(body, record) if isinstance(body, dict) else None
        if not updated:
            emit(False, "invalid exchange response")
            return
        emit(True, json.dumps(updated))
    except Exception as error:  # noqa: BLE001
        emit(False, str(error))


if __name__ == "__main__":
    main()
