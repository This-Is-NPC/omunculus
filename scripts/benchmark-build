#!/usr/bin/env bash
set -euo pipefail
cd "${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
cargo build --locked --release --manifest-path bench/stub/Cargo.toml --target-dir _build/bench/native/stub
cargo build --locked --release --manifest-path bench/runner/Cargo.toml --target-dir _build/bench/native/runner
MIX_ENV=bench mix release benchmark --overwrite
_build/bench/native/runner/release/capacity_benchmark stamp
