apps/kit/ui/TextBlock.qml implicitHeight
apps/kit/ui/TextBox.qml implicitHeight
apps/kit/ui/TraceButton.qml topMargin
apps/kit/ui/TraceButton.qml bottomMargin
apps/kit/ui/TraceButton.qml height

