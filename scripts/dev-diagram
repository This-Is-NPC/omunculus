#!/usr/bin/env python3
"""Draws a conversation of a dev project as a sequence diagram, read-only
from its store: people's messages and answers, works handed down and moved
between stages, requests and their escalations, grants, breaks, reopens,
retires, works done, artifacts, refused protocol calls and the deploy tools,
each step tagged with its work (W1, W2, ...). A work shows where it began, as
a card with how it ended. Writes dev/diagrams/<conversation>.mmd (Mermaid)
and .svg.

Usage: dev-diagram [--project agency|dev] [conversation id], or through
mise run dev:diagram.
The latest conversation of the project when no id is given.
"""
import argparse
import html
import json
import os
import re
import sqlite3
import subprocess
import sys
from datetime import datetime

STORES = {"agency": "dev/agency/.omunculus/store.sqlite3", "dev": "dev/.omunculus/store.sqlite3"}
# Tools drawn when they ran; the protocol tools are drawn only when refused.
TOOLS = {"deploy_preview", "promote", "request_golive", "wait_client"}
PROTOCOL = {"work", "delegate", "end", "reopen", "reply", "continue", "break", "retire", "escalate", "ask"}
CLIENT, OWNER, HARNESS = "Client", "Owner", "harness"
ROLES = {"origin": CLIENT, "owners": OWNER}
COLOURS = {CLIENT: "#b5651d", OWNER: "#7a1f1f", HARNESS: "#7b4bb0"}
PLAIN, REFUSED = "#333333", "#c0392b"
# A work card's border and fill by how the work ended; any other state is open.
STATES = {"done": ("#3d7a3d", "#e6f2e6"), "cancelled": ("#888888", "#eeeeee")}
OPEN = ("#c0392b", "#fbe3e0")
FONT = "Noto Sans, DejaVu Sans, Liberation Sans, sans-serif"
CW, CWB = 6.0, 6.6  # Text width per character at 11 px, regular and bold.
COL, TOP, LH, LEFT = 170, 70, 13, 40  # Column pitch, first row, text line height.
HEAD = 40  # Steps between repeated participant headers.
GAP = 60  # Seconds of silence that earn a separator row.


def short(text, n=90):
    text = " ".join(str(text or "").split())
    return text if len(text) <= n else text[: n - 1] + "…"


def fit(text, px, bold=False):
    return short(text, max(int(px / (CWB if bold else CW)), 4))


def width(text, bold=False):
    return len(text) * (CWB if bold else CW)


def seconds(iso):
    return datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp()


def steps_of(db, conv, client_agent):
    """The diagram's steps in event order, as dicts: shape (arrow or note),
    a, b, the tag, the kind shown on the line, the message shown to the right,
    and the style (dashed, colour, tone, card, mark)."""
    works = {r["id"]: r for r in db.execute("select * from works where conversation_id = ?", (conv,))}
    by_event = {r["event_id"]: r for r in works.values()}
    requests = {r["id"]: r for r in db.execute("select * from requests")}
    events = list(db.execute("select * from events where conversation_id = ? order by sequence", (conv,)))
    bodies = {e["id"]: json.loads(e["body"] or "{}") for e in events}
    escalations = [dict(r) for r in db.execute("select * from request_escalations")]
    by_escalated, by_origin = {}, {}
    for r in escalations:
        by_escalated.setdefault(r["escalated_id"], []).append(r)
        by_origin.setdefault(r["origin_id"], []).append(r)

    # What a request's opening event recorded: its role, work and step.
    opening = {e["request_id"]: e for e in events if e["type"] == "request"}
    grant_of = {}
    for e in events:
        if e["type"] == "grant":
            grant_of.setdefault(e["request_id"], []).append(e)
    grants_drawn = set()
    comments = [e for e in events if e["type"] == "comment"]
    runs_of, run_agents, tool_names, creators = {}, {}, {}, {}
    for e in events:
        if e["type"] == "start-run":
            run_agents[e["run_id"]] = bodies[e["id"]].get("agent")
            if e["work_id"]:
                runs_of.setdefault(e["work_id"], []).append((e["sequence"], run_agents[e["run_id"]]))
        elif e["type"] == "tool":
            tool_names.setdefault(e["run_id"], set()).add(bodies[e["id"]].get("name"))
        if e["id"] in by_event:
            creators[by_event[e["id"]]["id"]] = e["actor_id"]
    via = {r["id"]: r["via"] for r in db.execute("select id, via from runs where conversation_id = ?", (conv,))}

    # Each work's tag, in the order the works began.
    tags = {}
    for e in events:
        if e["id"] in by_event:
            tags[by_event[e["id"]]["id"]] = f"W{len(tags) + 1}"

    def first_agent(work_id):
        return runs_of[work_id][0][1] if runs_of.get(work_id) else works[work_id]["assignee"]

    def next_agent(work_id, seq):
        """The agent of the first run a work gets after an event."""
        return next((a for s, a in runs_of.get(work_id, []) if s > seq), None)

    def role(request_id):
        """The person a request goes to, from the destination its opening event recorded."""
        o = opening.get(request_id)
        return ROLES.get(bodies[o["id"]].get("destination") if o else None, OWNER)

    def requester(request_id):
        return json.loads(requests[request_id]["requester"]).get("agent", CLIENT)

    def report(work_id, actor, seq):
        mine = [bodies[c["id"]].get("body") for c in comments if c["work_id"] == work_id and c["actor_id"] == actor and c["sequence"] < seq]
        return mine[-1] if mine else works[work_id]["title"]

    # The last continue to nothing completes a work; the last retire cancels it.
    ended = {}
    for e in events:
        if e["type"] == "continue" and not bodies[e["id"]].get("to") or e["type"] == "cancel":
            ended[e["work_id"]] = e["id"]

    steps, art = [], {}

    def add(e, shape, a, b, kind, msg, work_id=None, **style):
        step = {"shape": shape, "a": a, "b": b, "kind": kind, "msg": msg, "seq": e["sequence"], "at": e["at"],
                "tag": tags.get(work_id or e["work_id"], ""), **style}
        steps.append(step)
        return step

    def between(e, a, b, kind, msg, **style):
        """An arrow; from an agent to itself, a note for a stage it keeps, else a loop."""
        return add(e, ("note" if kind.startswith("->") else "self") if a == b else "arrow", a, b, kind, msg, **style)

    for e in events:
        kind, actor, body = e["type"], e["actor_id"], bodies[e["id"]]
        if kind == "prompt":
            head, _, rest = (body.get("message") or "").strip().partition("\n")
            add(e, "arrow", CLIENT, body.get("agent") or client_agent, "message", f"{head.strip()} — {' '.join(rest.split())}" if rest.strip() else head)
        elif kind in ("delegate", "work") and e["id"] in by_event:
            w = by_event[e["id"]]
            flow = f"[{w['workflow']}] " if w["workflow"] else ""
            if w["state"] in STATES:
                state = f"ended: {w['state']}"
            else:
                state = "open" + (f": waiting for {w['waiting_for'] or w['waiting']}" if w["waiting"] else "")
            between(e, actor, first_agent(w["id"]), "hand-off", f"{flow}{w['title']} ({state})", work_id=w["id"], card=STATES.get(w["state"], OPEN), state=state, title=w["title"])
        elif kind == "request" and e["request_id"] in requests:
            r = requests[e["request_id"]]
            arbiter = json.loads(r["arbiter"])
            to = arbiter["agent"] if arbiter.get("kind") == "agent" else role(e["request_id"])
            work_id, label, msg = e["work_id"], "ask", body.get("reason", "")
            options = body.get("options") or {}
            names = sorted({c["args"].get("name") for calls in options.values() for c in calls if c.get("name") == "grant"})
            if names:
                label, msg = "request access", f"request access: {', '.join(names)} — {msg}"
            for esc in by_escalated.get(e["request_id"], []):
                # An escalation points at the request it passes on, and belongs to its work.
                work_id = work_id or opening[esc["origin_id"]]["work_id"]
                label, msg = f"escalates #{{{esc['origin_id']}}}", f"escalates #{{{esc['origin_id']}}} [{esc['part']}]: {msg}"
            between(e, actor, to, label, msg, work_id=work_id)
            steps[-1]["rid"] = e["request_id"]
        elif kind == "reply" and e["request_id"] in requests:
            rid = e["request_id"]
            answer = body.get("option") or body.get("body", "")
            text = body.get("body", "")
            option = body.get("option")
            msg = f"answer {option}" if text in (option, "") else f"answer {option}: {text}" if option else f"answer: {text}"
            for g in grant_of.get(rid, []):
                grants_drawn.add(g["id"])
                gb = bodies[g["id"]]
                msg += f" -> GRANT {gb['name']} to {gb['agent']}"
            if e["actor_kind"] == "agent":
                between(e, actor, requester(rid), "answer", msg, dashed=True, open=True)
            elif rid in by_origin:
                # The part of a human answer passed on through the escalating agent.
                esc = by_origin[rid][0]
                between(e, requester(esc["escalated_id"]), requester(rid), f"part {esc['part']}", f"part {esc['part']}: {msg.removeprefix('answer ')}", dashed=True, open=True, colour=COLOURS[role(esc["escalated_id"])])
            else:
                between(e, role(rid), requester(rid), "answer", msg, dashed=True, open=True)
        elif kind == "grant" and e["id"] not in grants_drawn:
            add(e, "arrow", OWNER, body.get("agent", "?"), "grant", f"GRANT {body.get('name')} to {body.get('agent')} ({body.get('scope') or 'this work'})")
        elif kind == "continue" and body.get("to"):
            to = next_agent(e["work_id"], e["sequence"])
            msg = f"stage {body.get('from')} -> {body['to']}"
            between(e, actor, to or actor, f"-> {body['to']}", msg)
        elif kind == "continue" and e["work_id"] in works:
            w = works[e["work_id"]]
            last = ended.get(w["id"]) == e["id"] and w["state"] == "done"
            between(e, actor, creators.get(w["id"]) or actor, "done", f"done: {short(report(w['id'], actor, e['sequence']), 200)}", dashed=True, open=True, mark="check" if last else None)
        elif kind == "break" and e["work_id"] in works:
            w = works[e["work_id"]]
            to = creators.get(w["id"]) or actor
            if via.get(e["run_id"]) == "retry" or "break" not in tool_names.get(e["run_id"], ()):
                between(e, HARNESS, to, "harness stop", f"harness: stopped {body.get('body', '')}", dashed=True, open=True, tone="harness")
            else:
                between(e, actor, to, "break", f"BREAK: {body.get('body', '')}", dashed=True, open=True)
        elif kind == "reopen":
            stage = body.get("stage")
            to = next_agent(e["work_id"], e["sequence"]) or actor
            between(e, actor, to, "reopen", f"reopen at {stage}" if stage else "reopen")
        elif kind == "cancel" and e["work_id"] in works:
            agent = ([a for s, a in runs_of.get(e["work_id"], []) if s < e["sequence"]] or [works[e["work_id"]]["assignee"]])[-1]
            between(e, actor, agent, "retired", f"retired: {body.get('body', '')}", mark="x")
        elif kind == "artifact":
            name = re.sub(r"-[0-9a-f]{32}", "", body.get("name") or "")
            ext = name.rpartition(".")[2] if "." in name else ""
            base = name[: -len(ext) - 1] if ext else name
            key = (e["work_id"], body.get("version"), e["at"][:19])
            if key in art:
                art[key]["exts"].append(ext)
                art[key]["msg"] = f"artifact {base} v{body.get('version')} (+{', '.join(art[key]['exts'])})"
            else:
                art[key] = add(e, "note", actor, actor, "artifact", f"artifact {base} v{body.get('version')}", exts=[])
        elif kind == "comment" and e["request_id"] and actor:
            add(e, "note", actor, actor, "comment", f"comment: {body.get('body', '')}")
        elif kind == "tool" and body.get("name") in TOOLS | PROTOCOL:
            out = str(body.get("output") or "").removeprefix("refused: ")
            if body.get("ok") is False:
                add(e, "note", actor, actor, f"refused {body['name']}", f"refused: {body['name']}: {out}", tone="refused")
            elif body["name"] in TOOLS:
                add(e, "note", actor, actor, body["name"], f"{body['name']}: {out}" if out else body["name"])
    steps = [s for s in steps if s["a"] and s["b"]]

    # A step to resolve: the number of the request an escalation came from.
    number = {s["rid"]: i + 1 for i, s in enumerate(steps) if "rid" in s}
    for s in steps:
        for field in ("kind", "msg"):
            s[field] = re.sub(r"#\{(\w+)\}", lambda m: f"#{number.get(m.group(1), '?')}", s[field])

    # Where each work ended: the check or cross goes on its lifeline.
    for s in steps:
        s["mark_on"] = s["a"] if s.get("mark") == "check" else s["b"]
    runs = []
    for e in events:
        if e["type"] == "start-run":
            end = next((x["sequence"] for x in events if x["type"] == "end-run" and x["run_id"] == e["run_id"]), float("inf"))
            runs.append((bodies[e["id"]].get("agent"), e["sequence"], end))
    return steps, runs


def participants(steps, seed):
    """The people at the ends; between them the agents seeded in the order of
    the work tree, then adjacent swaps that shorten the arrows."""
    used = {n for s in steps for n in (s["a"], s["b"])}
    middle = []
    for n in seed + [n for s in steps for n in (s["a"], s["b"])]:
        if n in used and n not in middle and n not in (CLIENT, OWNER):
            middle.append(n)
    arrows = [(s["a"], s["b"]) for s in steps if s["shape"] == "arrow"]

    def cost(mid):
        pos = {n: i for i, n in enumerate([CLIENT] + mid + [OWNER])}
        return sum(abs(pos[a] - pos[b]) for a, b in arrows)

    improved = True
    while improved:
        improved = False
        for i in range(len(middle) - 1):
            swapped = middle[:i] + [middle[i + 1], middle[i]] + middle[i + 2:]
            if cost(swapped) < cost(middle):
                middle, improved = swapped, True
    return [n for n in [CLIENT] + middle + [OWNER] if n in used]


def tree_order(db, conv):
    """The agents in depth-first order over the works, to seed the layout."""
    works = list(db.execute("select id, parent_id, assignee from works where conversation_id = ? order by rowid", (conv,)))
    kids = {}
    for w in works:
        kids.setdefault(w["parent_id"], []).append(w)
    order = []

    def visit(w):
        if w["assignee"] and w["assignee"] not in order:
            order.append(w["assignee"])
        for k in kids.get(w["id"], []):
            visit(k)

    for w in kids.get(None, []):
        visit(w)
    return order


def colour_of(s):
    if s.get("tone") == "refused":
        return REFUSED
    if s.get("tone") == "harness":
        return COLOURS[HARNESS]
    if s.get("card"):
        return s["card"][0]
    return s.get("colour") or COLOURS.get(s["a"]) or COLOURS.get(s["b"]) or PLAIN


def label_of(n, s):
    return f"{n}. {s['at'][11:19]} {s['tag']} {s['kind']}".replace("  ", " ")


def rows_of(steps):
    """Rows in order: a step, or a separator after a gap of silence."""
    rows, last = [], None
    for i, s in enumerate(steps):
        t = seconds(s["at"])
        if last is not None and t - last > GAP:
            m = round((t - last) / 60)
            rows.append(("gap", f"{m // 60} h {m % 60} min" if m >= 60 else f"{m} min"))
        rows.append(("step", i))
        last = t
    return rows


def run_spans(steps, runs):
    """Each run's first and last step on its agent's lifeline."""
    spans = []
    for agent, start, end in runs:
        hit = [i for i, s in enumerate(steps) if start <= s["seq"] <= end and agent in (s["a"], s["b"])]
        if hit:
            spans.append((agent, hit[0], hit[-1]))
    return spans


def mermaid(parts, steps, runs):
    clean = lambda text: re.sub(r"[#;]", lambda m: f"#{ord(m.group())};", short(text, 120))
    ids = {p: f"P{i}" for i, p in enumerate(parts)}
    spans = run_spans(steps, runs)
    lines = ["sequenceDiagram"]
    lines += [f"    {'actor' if p in (CLIENT, OWNER) else 'participant'} {ids[p]} as {p}" for p in parts]
    for i, s in enumerate(steps):
        a, b, n = ids[s["a"]], ids[s["b"]], i + 1
        lines += [f"    activate {ids[agent]}" for agent, first, _ in spans if first == i]
        text = clean(f"{n}. {s['at'][11:19]} {s['tag']} {s['msg']}".replace("  ", " "))
        if s.get("tone") == "refused":
            lines.append(f"    {a}-x{a}: {text}")
        elif s["shape"] == "note":
            lines.append(f"    Note over {a}: {text}")
        elif s.get("tone") == "harness" or s["kind"] == "break":
            lines.append(f"    {a}--x{b}: {text}")
        elif s.get("mark") == "x":
            lines.append(f"    {a}-x{b}: {text}")
        else:
            lines.append(f"    {a}{'-->>' if s.get('dashed') else '->>'}{b}: {text}")
        if s.get("card"):
            lines.append(f"    Note over {a},{b}: {s['tag']} {s['state']}" if a != b else f"    Note over {a}: {s['tag']} {s['state']}")
        lines += [f"    deactivate {ids[agent]}" for agent, _, last in spans if last == i]
    return "\n".join(lines) + "\n"


def wrap(text, px, bold=False, lines=3):
    """Greedy word wrap to px wide, at most `lines` lines, the last cut with an ellipsis."""
    cw = CWB if bold else CW
    cap = max(int(px / cw), 8)
    out, cur = [], ""
    for word in " ".join(str(text).split()).split(" "):
        while len(word) > cap:
            if cur:
                out.append(cur)
                cur = ""
            out.append(word[:cap])
            word = word[cap:]
        if cur and len(cur) + 1 + len(word) > cap:
            out.append(cur)
            cur = word
        else:
            cur = f"{cur} {word}".strip()
    if cur:
        out.append(cur)
    if len(out) > lines:
        out = out[:lines]
        out[-1] = out[-1][: cap - 1].rstrip() + "…"
    return out


def text_of(n, s):
    """The step's text: number, time and work tag, then the kind and message."""
    prefix = f"{n}. {s['at'][11:19]} {s['tag']}".replace("  ", " ")
    msg, kind = s["msg"], s["kind"]
    if s.get("card") or kind.startswith("->") or msg.lower().startswith(kind.split()[0].lower()):
        return f"{prefix} {msg}"
    return f"{prefix} {kind}: {msg}"


def svg(parts, steps, runs):
    x = {name: LEFT + COL // 2 + i * COL for i, name in enumerate(parts)}
    last_x = x[parts[-1]]
    halo = 'stroke="#fffdf8" stroke-width="3" paint-order="stroke"'
    markers = {}

    def marker(colour, open_head):
        key = (colour, open_head)
        if key not in markers:
            markers[key] = f"m{len(markers)}"
        return markers[key]

    # Lay each step out first: its wrapped text, box and height (rows grow to fit).
    plan = []
    right = last_x + COL // 2 + 20
    for i, s in enumerate(steps):
        full = text_of(i + 1, s)
        card = s.get("card") is not None
        p = {"full": full}
        if s["shape"] == "note":
            lines = wrap(full, int(2.5 * COL) - 14, False)
            w = max(width(l) for l in lines) + 14
            p.update(lines=lines, w=w, h=len(lines) * LH + 20, left=max(x[s["a"]] - w / 2, 8))
            right = max(right, p["left"] + w + 20)
        elif s["shape"] == "self":
            lines = wrap(full, 2 * COL - 44, card)
            p.update(lines=lines, h=max(len(lines) * LH, 18) + 16, left=x[s["a"]] + 32)
            right = max(right, p["left"] + max(width(l, card) for l in lines) + 30)
        else:
            left = min(x[s["a"]], x[s["b"]])
            lines = wrap(full, max(abs(x[s["a"]] - x[s["b"]]), 2 * COL) - 14, card)
            p.update(lines=lines, left=left, h=len(lines) * LH + (9 if card else 0) + 20)
            right = max(right, left + max(width(l, card) for l in lines) + 20)
        plan.append(p)
    canvas = int(max(right, LEFT + 760))

    # Rows from top to bottom: steps, gaps, and a header row every HEAD steps and at the end.
    layout, y, count = [], TOP - 20, 0
    for kind, i in rows_of(steps):
        h = plan[i]["h"] if kind == "step" else 26
        layout.append((kind, i, y, h))
        y += h
        if kind == "step":
            count += 1
            if count % HEAD == 0 and i < len(steps) - 1:
                layout.append(("head", None, y, 50))
                y += 50
    layout.append(("head", None, y, 50))
    life_end, legend_y = y, y + 70
    height = legend_y + 230
    y_of = {}
    bg, body = [], []
    for kind, i, top, h in layout:
        if kind == "gap":
            mid = top + h / 2
            bg.append(f'<line x1="{LEFT}" y1="{mid}" x2="{canvas - LEFT}" y2="{mid}" stroke="#bbb" stroke-dasharray="1 4"/>')
            bg.append(f'<text x="{(LEFT + canvas) // 2}" y="{mid + 4}" text-anchor="middle" fill="#888" {halo}>... {i} ...</text>')
        elif kind == "step":
            p = plan[i]
            p["top"] = top
            p["y"] = top + h / 2 if steps[i]["shape"] != "arrow" else top + h - 10
            y_of[i] = p["y"]
            if i % 2:
                bg.append(f'<rect x="0" y="{top}" width="{canvas}" height="{h}" fill="#f7f3e8"/>')

    # Activation bars of the runs, under the arrows.
    for agent, first, last in run_spans(steps, runs):
        body.append(f'<rect x="{x[agent] - 3}" y="{y_of[first] - 9}" width="6" height="{y_of[last] - y_of[first] + 18}" fill="#d9e2ec" fill-opacity="0.8" stroke="#9fb3c8"/>')

    def put(lines, px, first_y, fill, extra=""):
        for k, line in enumerate(lines):
            body.append(f'<text x="{px[0]}" y="{first_y + k * LH}" fill="{fill}" {extra}>{html.escape(line)}{px[1]}</text>')

    for i, s in enumerate(steps):
        p, colour = plan[i], colour_of(s)
        y, lines, title = p["y"], p["lines"], f"<title>{html.escape(p['full'])}</title>"
        if s["shape"] == "note":
            fill, edge, ink = ("#fbe3e0", REFUSED, "#8a1f14") if s.get("tone") == "refused" else ("#f3eed2", "#d8cf9a", "#555")
            body.append(f'<rect x="{p["left"]:.0f}" y="{y - p["h"] / 2 + 4:.0f}" width="{p["w"]:.0f}" height="{p["h"] - 8:.0f}" fill="{fill}" stroke="{edge}">{title}</rect>')
            for k, line in enumerate(lines):
                body.append(f'<text x="{p["left"] + p["w"] / 2:.0f}" y="{y - len(lines) * LH / 2 + 10 + k * LH:.0f}" fill="{ink}" text-anchor="middle" font-style="italic">{html.escape(line)}{title}</text>')
            continue
        card, head = s.get("card"), marker(colour, bool(s.get("open")))
        dash = ' stroke-dasharray="1 3"' if s.get("tone") == "harness" else ' stroke-dasharray="5 3"' if s.get("dashed") else ""
        stroke = 2 if card or s.get("tone") == "harness" else 1
        if s["shape"] == "self":
            cx = x[s["a"]]
            body.append(f'<path d="M{cx},{y - 8} h24 v16 h-24" fill="none" stroke="{colour}" stroke-width="{stroke}"{dash} marker-end="url(#{head})">{title}</path>')
            top = y - len(lines) * LH / 2 + 10
            if card:
                body.append(f'<rect x="{p["left"] - 6}" y="{top - 11}" width="{max(width(l, True) for l in lines) + 12:.0f}" height="{len(lines) * LH + 4}" rx="8" fill="{card[1]}" stroke="{card[0]}">{title}</rect>')
                put(lines, (p["left"], title), top, card[0], 'font-weight="bold"')
            else:
                put(lines, (p["left"], title), top, colour, halo)
        else:
            body.append(f'<line x1="{x[s["a"]]}" y1="{y}" x2="{x[s["b"]]}" y2="{y}" stroke="{colour}" stroke-width="{stroke}"{dash} marker-end="url(#{head})">{title}</line>')
            first = y - (8 if card else 5) - (len(lines) - 1) * LH
            if card:
                top = first - 12
                body.append(f'<rect x="{p["left"]}" y="{top}" width="{max(width(l, True) for l in lines) + 12:.0f}" height="{len(lines) * LH + 3}" rx="8" fill="{card[1]}" stroke="{card[0]}">{title}</rect>')
                put(lines, (p["left"] + 6, title), first, card[0], 'font-weight="bold"')
            else:
                put(lines, (p["left"] + 6, title), first, colour, halo)
        mark = s.get("mark")
        if mark == "x":
            cx = x[s["mark_on"]]
            body.append(f'<path d="M{cx - 5},{y - 2} l10,10 m0,-10 l-10,10" stroke="{REFUSED}" stroke-width="2.5" fill="none"/>')
        elif mark == "check":
            cx = x[s["mark_on"]] + (14 if x[s["b"]] < x[s["a"]] else -14)
            body.append(f'<path d="M{cx - 5},{y + 6} l3.5,4 l6.5,-9" stroke="{STATES["done"][0]}" stroke-width="2.5" fill="none"/>')
    out = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{canvas}" height="{height}" font-family="{FONT}" font-size="11">',
           f'<rect width="{canvas}" height="{height}" fill="#fffdf8"/>']
    defs = "".join(
        f'<marker id="{mid}" markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">'
        + (f'<path d="M0,0 L10,4 L0,8" fill="none" stroke="{c}"/>' if o else f'<path d="M0,0 L10,4 L0,8 z" fill="{c}"/>')
        + "</marker>" for (c, o), mid in markers.items())
    out.append(f"<defs>{defs}</defs>")
    out += bg
    for name in parts:
        out.append(f'<line x1="{x[name]}" y1="{TOP - 20}" x2="{x[name]}" y2="{life_end + 10}" stroke="#ccc" stroke-dasharray="4 4"/>')
    out += body
    for hy in [10] + [top + 10 for kind, _, top, _ in layout if kind == "head"]:
        for name in parts:
            bw = min(max(width(name, True) + 24, 100), COL - 12)
            out.append(f'<rect x="{x[name] - bw / 2:.0f}" y="{hy}" width="{bw:.0f}" height="30" rx="{15 if name in (CLIENT, OWNER) else 4}" fill="{COLOURS.get(name, "#2f4858")}"/>')
            out.append(f'<text x="{x[name]}" y="{hy + 20}" fill="#fff" text-anchor="middle" font-weight="bold">{html.escape(name)}</text>')
    out += legend(LEFT, legend_y)
    out.append("</svg>")
    return "\n".join(out) + "\n"


def legend(x, y):
    """A key to the drawing's conventions, one row each."""
    box = [f'<rect x="{x}" y="{y}" width="720" height="206" fill="#fff" stroke="#ccc"/>']
    row = lambda i: y + 22 + i * 21
    text = lambda i, t, dx=62: box.append(f'<text x="{x + dx}" y="{row(i) + 4}" fill="#333">{html.escape(t)}</text>')
    for i, dash in ((0, ""), (1, ' stroke-dasharray="5 3"')):
        box.append(f'<line x1="{x + 12}" y1="{row(i)}" x2="{x + 52}" y2="{row(i)}" stroke="#333"{dash}/>')
    text(0, "solid arrow: request or hand-off (a work handed down, a stage move, a reopen, a retire)")
    text(1, "dashed arrow: answer, work done, break; purple dotted: stopped by the harness")
    for i, (name, (edge, fill)) in enumerate((("done", STATES["done"]), ("cancelled", STATES["cancelled"]), ("open", OPEN))):
        box.append(f'<rect x="{x + 12 + i * 70}" y="{row(2) - 8}" width="62" height="16" rx="8" fill="{fill}" stroke="{edge}"/>')
        box.append(f'<text x="{x + 43 + i * 70}" y="{row(2) + 4}" fill="{edge}" text-anchor="middle" font-weight="bold">{name}</text>')
    text(2, "work card on the arrow that created it: how the work ended; open shows what it waits for", 230)
    box.append(f'<rect x="{x + 12}" y="{row(3) - 8}" width="40" height="16" fill="#f3eed2" stroke="#d8cf9a"/>')
    text(3, "yellow note on a lifeline: stage move kept by the same agent, artifact, tool, comment")
    box.append(f'<rect x="{x + 12}" y="{row(4) - 8}" width="40" height="16" fill="#fbe3e0" stroke="{REFUSED}"/>')
    text(4, "red note: a refused call")
    box.append(f'<rect x="{x + 29}" y="{row(5) - 8}" width="6" height="16" fill="#d9e2ec" stroke="#9fb3c8"/>')
    text(5, "bar on a lifeline: a run of the agent")
    box.append(f'<path d="M{x + 14},{row(6) - 6} l12,12 m0,-12 l-12,12" stroke="{REFUSED}" stroke-width="2.5" fill="none"/>')
    box.append(f'<path d="M{x + 34},{row(6)} l3.5,4 l6.5,-9" stroke="{STATES["done"][0]}" stroke-width="2.5" fill="none"/>')
    text(6, "cross: work retired here; check: work done here")
    text(7, "each text sits on its arrow: N. HH:MM:SS Wn (event order, time, work); loop: a step by an agent to itself", 12)
    text(8, "... N min ...: silence over a minute; Client and Owner by the destination a request recorded", 12)
    return box


def main():
    parser = argparse.ArgumentParser(description="Draw a dev project's conversation as a sequence diagram")
    # mise passes the task's usage as usage_* variables.
    parser.add_argument("--project", choices=sorted(STORES), default=os.environ.get("usage_project") or "agency")
    parser.add_argument("conversation", nargs="?", default=os.environ.get("usage_conversation") or None)
    args = parser.parse_args()

    root = os.environ.get("MISE_PROJECT_ROOT") or subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip()
    store = os.path.join(root, STORES[args.project])
    if not os.path.exists(store):
        sys.exit(f"no store at {store}: run the dev server on the {args.project} project first")
    db = sqlite3.connect(f"file:{store}?mode=ro", uri=True)
    db.row_factory = sqlite3.Row
    conv = args.conversation or (db.execute("select id from conversations order by rowid desc limit 1").fetchone() or [None])[0]
    if not conv or not db.execute("select 1 from conversations where id = ?", (conv,)).fetchone():
        sys.exit(f"no conversation {conv} in {store}" if conv else f"no conversations in {store}")

    # The agent the person's first message went to is the one that talks with them.
    first = db.execute("select body from events where conversation_id = ? and type = 'prompt' order by sequence limit 1", (conv,)).fetchone()
    client_agent = json.loads(first["body"]).get("agent") if first else None
    steps, runs = steps_of(db, conv, client_agent)
    parts = participants(steps, [client_agent] + tree_order(db, conv))

    out = os.path.join(root, "dev", "diagrams")
    os.makedirs(out, exist_ok=True)
    for ext, text in (("mmd", mermaid(parts, steps, runs)), ("svg", svg(parts, steps, runs))):
        with open(os.path.join(out, f"{conv}.{ext}"), "w") as f:
            f.write(text)
    print(os.path.join(out, f"{conv}.svg"))


main()
