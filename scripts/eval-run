#!/usr/bin/env bash
set -euo pipefail
cd "${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"

# The providers' keys come from .env, as the dev server's do.
if [[ -f .env ]]; then
  set -a
  source .env
  set +a
fi

# The task's flags, from the usage_* variables mise sets.
args=()
for flag in model k label timeout jobs against overlay resume; do
  value=usage_$flag
  [[ -z ${!value:-} ]] || args+=("--$flag" "${!value}")
done
# A repeatable flag: mise joins its values, shell-quoted, in one variable.
for flag in agent-model task configuration; do
  value=usage_${flag//-/_}
  eval "values=(${!value:-})"
  for each in "${values[@]}"; do
    args+=("--$flag" "$each")
  done
done
[[ ${usage_code_mode:-} != true ]] || args+=(--code-mode)
exec mix run eval/run.exs run "${args[@]}"
